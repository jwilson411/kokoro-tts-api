# Copy to .env and export, or export these before `python -m app.main`.
# This process has no API keys. Do not put tokens here.

# Bind address. Default 127.0.0.1. The Docker image sets 0.0.0.0.
KOKORO_HOST=127.0.0.1

# Port. Default 8765.
KOKORO_PORT=8765

# Default voice. Must be in GET /voices.
KOKORO_VOICE=am_michael

# Set to 1 for the silent stub engine (CI). Leave unset for live Kokoro-82M.
# KOKORO_STUB=1
